{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "laravel/framework": "13.22.0",
        "laravel/sanctum": "4.3.3",
        "laravel/tinker": "3.0.2",
        "openspout/openspout": "4.32.0",
        "overtrue/laravel-versionable": "6.0.0",
        "spatie/laravel-medialibrary": "11.23.3",
        "spatie/laravel-permission": "8.3.0"
    },
    "require-dev": {
        "fakerphp/faker": "1.24.1",
        "larastan/larastan": "3.10.0",
        "laravel/sail": "1.64.0",
        "laravel/pail": "1.2.7",
        "laravel/pao": "1.1.3",
        "laravel/pint": "1.30.3",
        "mockery/mockery": "1.6.12",
        "nunomaduro/collision": "8.9.5",
        "pestphp/pest": "4.7.8",
        "pestphp/pest-plugin-laravel": "4.1.0",
        "phpstan/phpstan": "2.2.7",
        "phpunit/phpunit": "12.5.33"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "test:prepare": [
            "@php -r 'if (! file_exists(\".env.testing\") && ! copy(\".env.testing.example\", \".env.testing\")) { fwrite(STDERR, \"Unable to initialize .env.testing from the tracked template.\\n\"); exit(1); } $environment = [\"APP_ENV\" => \"testing\", \"DB_URL\" => \"\", \"DB_CONNECTION\" => \"mysql\", \"DB_HOST\" => \"mysql\", \"DB_PORT\" => \"3306\", \"DB_DATABASE\" => \"master_plan_it_test\", \"DB_USERNAME\" => \"sail\", \"DB_PASSWORD\" => \"password\"]; foreach ($environment as $key => $value) { putenv($key.\"=\".$value); $_ENV[$key] = $value; $_SERVER[$key] = $value; } require \"vendor/autoload.php\"; $app = require \"bootstrap/app.php\"; $kernel = $app->make(Illuminate\\Contracts\\Console\\Kernel::class); $kernel->bootstrap(); $connection = $app->make(\"db\")->connection(); $mode = (string) $connection->selectOne(\"SELECT @@SESSION.sql_mode AS sql_mode\")->sql_mode; $valid = $app->environment(\"testing\") && $connection->getDriverName() === \"mysql\" && $connection->getConfig(\"host\") === \"mysql\" && $connection->getDatabaseName() === \"master_plan_it_test\" && str_contains($mode, \"STRICT_TRANS_TABLES\"); if (! $valid) { fwrite(STDERR, \"Refusing test migration: APP_ENV=testing, MySQL host mysql, master_plan_it_test and STRICT_TRANS_TABLES are required.\\n\"); exit(1); }'",
            "APP_ENV=testing DB_URL= DB_CONNECTION=mysql DB_HOST=mysql DB_PORT=3306 DB_DATABASE=master_plan_it_test DB_USERNAME=sail DB_PASSWORD=password php artisan migrate --env=testing --force"
        ],
        "test:static": [
            "@composer validate --strict --no-check-all",
            "@php vendor/bin/pest tests/Architecture",
            "@php vendor/bin/pint --test",
            "@php -d memory_limit=-1 vendor/bin/phpstan analyse --no-progress",
            "@composer audit --locked --no-interaction"
        ],
        "test:accounting": "@php artisan test --testsuite=Accounting",
        "test:economic-coverage": [
            "@php -d xdebug.mode=coverage vendor/bin/phpunit -c phpunit.economic-coverage.xml",
            "@php tests/Support/assert-economic-coverage.php build/economic-coverage/cobertura.xml"
        ],
        "test:application": "@php artisan test --testsuite=Application",
        "verify": [
            "@test:static",
            "@test:prepare",
            "@test:accounting",
            "@test:application"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.32"
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
