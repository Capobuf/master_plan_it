<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Economic">
            <directory>tests/Accounting/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app/Domain/Economics</directory>
            <file>app/Domain/Expenses/Services/PlafondCapacityService.php</file>
            <file>app/Domain/Expenses/Services/PlafondLifecycleGuard.php</file>
        </include>
    </source>
    <coverage pathCoverage="true">
        <report>
            <cobertura outputFile="build/economic-coverage/cobertura.xml"/>
        </report>
    </coverage>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_HOST" value="mysql" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="master_plan_it_test" force="true"/>
        <env name="DB_USERNAME" value="sail" force="true"/>
        <env name="DB_PASSWORD" value="password" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="database" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
